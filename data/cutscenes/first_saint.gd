extends RefCounted
## Катсцена «Первый святой» (CLAUDE.md §3, уровень 1, переулок у главной дороги). Проигрывает Cutscenes.
## Герой подошёл на звук мокрых ударов: святой в белом стоит на коленях над мёртвым и бьёт его окровавленным камнем,
## снова и снова — и не останавливается. Без джампскейра: страшно от звука и того, что он не перестаёт.
## Потом встаёт и уходит вглубь переулка (дальше — первый урок стелса). Удары и звук делает сам святой (Saint).
## ctx: actors.saint — святой; points.stone — камень в его руке (Callable), points.victim — тело.

const STEPS := [
	# Из глаз: герой видит его с дороги, в пятне света от светильника убитого
	{"camera": "look", "at": "saint", "time": 1.0},
	{"pause": 1.2},
	# Сзади, со стороны героя: медленный наезд — спина в белом, рука поднимается и падает
	{"shot": "close", "of": "saint", "side": 180, "dist": 2.8, "height": 0.35, "time": 3.4, "push": 0.8},
	# Вставка: камень в руке
	{"shot": "insert", "of": "stone", "side": -90, "dist": 0.85, "height": 0.35, "time": 2.2},
	# Снизу спереди, с завалом горизонта: лицо с повязкой над телом
	{"shot": "low", "of": "saint", "side": 15, "dist": 1.6, "time": 2.8, "roll": 7},
	# Встаёт и уходит в темноту переулка — смотрим ему в спину
	{"call": "first_saint_leave"},
	{"shot": "close", "of": "saint", "side": 180, "dist": 3.2, "height": 0.2, "time": 3.6},
	{"camera": "eyes", "time": 0.0},
	{"camera": "look", "at": "saint", "time": 0.6},
]
