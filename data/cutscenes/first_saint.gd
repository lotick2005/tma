extends RefCounted
## Катсцена «Первый святой» (CLAUDE.md §3, уровень 1, переулок у главной дороги). Проигрывает Cutscenes.
## Герой подошёл на звук мокрых ударов: святой в белом стоит на коленях над мёртвым и бьёт его окровавленным камнем,
## снова и снова. Без джампскейра и без дрожи: три спокойных неподвижных кадра ("track": false — камера стоит),
## страшно от звука и того, что он не перестаёт. Потом замирает, поворачивает голову, встаёт и уходит вглубь
## переулка (дальше — первый урок стелса). Удары и звук делает сам святой (Saint, удар раз в 1,5 с).
## ctx: actors.saint — святой; points.strike — куда падает камень (между святым и телом),
## points.alley_light — где свет катсцены (над ними), points.stone — камень в руке, points.victim — тело.

const STEPS := [
	{"call": "first_saint_steady"},
	# Свет в переулке ярче, чтобы фигуры читались (тёплый, как от светильника убитого)
	{"parallel": [
		{"camera": "look", "at": "saint", "time": 0.8},
		{"effect": "light", "id": "alley", "at": "alley_light", "color": Color(1.0, 0.74, 0.45), "energy": 1.0,
			"range": 6.5, "time": 1.0},
	]},
	# (а) Из-за плеча героя: силуэт на коленях в пятне света, рука поднимается и падает
	{"shot": "over_shoulder", "of": "strike", "fov": 44, "time": 4.5, "track": false},
	# (б) Сбоку, с его правой руки, средний план: тело, рука и камень — три удара целиком.
	# Переулок шириной 2 м: камера стоит в толще северной стены (стены изнутри не рисуются)
	{"shot": "close", "of": "saint", "look": "strike", "side": -60, "dist": 2.2, "height": 0.3, "fov": 60,
		"time": 5.2, "track": false},
	# (в) Со стороны героя, из-за его правого плеча: он замирает, поворачивает голову к камере,
	# встаёт и уходит в темноту переулка
	{"shot": "close", "of": "saint", "look": "saint", "side": -140, "dist": 2.6, "height": 0.1, "fov": 56,
		"track": false},
	{"pause": 1.3},
	{"call": "first_saint_freeze"},
	{"pause": 2.4},
	{"call": "first_saint_leave"},
	{"pause": 4.8},
	{"effect": "light", "id": "alley", "energy": 0.0, "time": 1.2},
	{"effect": "light", "id": "alley", "remove": true},
	{"camera": "eyes", "time": 0.0},
	{"camera": "look", "at": "saint", "time": 0.6},
]
